{
  "name": "solana-bot-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Interface desktop React et TypeScript pour le bot Solana",
  "main": "main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:web": "tsc --noEmit && vite build",
    "start": "electron .",
    "test": "node --test dashboard-data.test.cjs",
    "dist:win": "npm run build:web && electron-builder --win nsis portable"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "typescript": "5.7.3",
    "vite": "6.0.7"
  },
  "build": {
    "appId": "fr.solanabot.desktop",
    "productName": "Solana Bot",
    "directories": { "output": "release" },
    "files": ["main.js", "preload.js", "dashboard-data.cjs", "dist/**/*", "package.json"],
    "win": {
      "target": ["nsis", "portable"],
      "artifactName": "Solana-Bot-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
